            return
        end
        if catalogueScope ~= "favorites" and not detailView and not loading
            and not filterState.pending and normalizeSearch(searchInput.Text) == searchState.query then
            requestFreshCatalogue(30)
        end
        settings.scheduleRefresh()
    end)
end

