        if not scriptSource then return end
        local clipboard = type(setclipboard) == "function" and setclipboard
            or (type(toclipboard) == "function" and toclipboard)
        if not clipboard then
            showStatus("Clipboard unavailable")
            return
        end
        local ok = pcall(clipboard, scriptSource)
        showStatus(ok and "Copied" or "Unable to copy")
    end)
    local executing = false
    local confirmUntil = 0
    executeButton.Activated:Connect(function()
        if not scriptSource or executing or type(loadstring) ~= "function" then
            if type(loadstring) ~= "function" then
                showStatus("Execution unavailable")
            end
            return
        end
        if settings.values.confirmExecution and os.clock() > confirmUntil then
            confirmUntil = os.clock() + 4
            showStatus("Press play again to confirm")
            return
        end
        confirmUntil = 0
        executing = true
        showStatus("Running…")
        task.spawn(function()
            local ok, fn = pcall(loadstring, scriptSource)
            if not ok or type(fn) ~= "function" then
                executing = false
                if codeCard.Parent then showStatus("Compile failed: " .. tostring(fn):sub(1, 100)) end
                return
            end
            local ran, err = pcall(fn)
            executing = false
            if codeCard.Parent then
                showStatus(ran and "Executed" or ("Execution failed: " .. tostring(err):sub(1, 90)))
            end
        end)
    end)
    local function setCode(source, message)
        if not codeCard.Parent then return end
        if type(source) == "string" and source ~= "" then
            scriptSource = source
            codeText.Text = #source > 70000
                and (source:sub(1, 70000) .. "\n\n… Preview truncated; copy to get complete source.")
                or source
        else
            scriptSource = nil
            codeText.Text = message or "Code unavailable."
        end
        copyButton.Visible = scriptSource ~= nil
        executeButton.Visible = scriptSource ~= nil
        codeScroll.CanvasPosition = Vector2.zero
    end
    local function resize()
        local width = math.max(1, math.floor(body.AbsoluteSize.X))
        local height = math.max(1, math.floor(body.AbsoluteSize.Y))
        local gap = width >= 450 and 12 or 8
        local leftWidth = math.max(1, math.floor((width - gap) * 0.42))
        local rightWidth = math.max(1, width - gap - leftWidth)
        left.Position = UDim2.fromOffset(0, 0)
        left.Size = UDim2.fromOffset(leftWidth, height)
        local reserved = data and math.min(126, math.max(64, math.floor(height * 0.38))) or 0
        local availableHeight = math.max(1, height - reserved - (data and gap or 0) - 2)
        local imageWidth = math.max(1, math.min(leftWidth - 2, math.floor(availableHeight * 16 / 9)))
        local imageHeight = math.max(1, math.floor(imageWidth * 9 / 16))
        picture.Position = UDim2.fromOffset(math.floor((leftWidth - imageWidth) / 2), 1)
        picture.Size = UDim2.fromOffset(imageWidth, imageHeight)
        local commentHeight = math.max(0, height - imageHeight - gap - 2)
        commentsCard.Position = UDim2.fromOffset(0, imageHeight + gap + 2)
        commentsCard.Size = UDim2.fromOffset(leftWidth, commentHeight)
        commentsCard.Visible = data ~= nil and commentHeight >= 64
        card.Position = UDim2.fromOffset(leftWidth + gap, 0)
        local informationHeight = data and math.max(1, math.floor(height * 0.55)) or height
        card.Size = UDim2.fromOffset(rightWidth, informationHeight)
        codeCard.Visible = data ~= nil
        if data then
            codeCard.Position = UDim2.fromOffset(leftWidth + gap, informationHeight + gap)
            codeCard.Size = UDim2.fromOffset(rightWidth, math.max(1, height - informationHeight - gap))
        end
    end

    local function updateScroll()
        local overflow = stack.AbsoluteContentSize.Y > scroll.AbsoluteWindowSize.Y + 1
        scroll.ScrollingEnabled = overflow
        scroll.ScrollBarThickness = overflow and 3 or 0
        if not overflow then
            scroll.CanvasPosition = Vector2.zero
        end
    end
    local function updateComments()
        local overflow = commentsLayout.AbsoluteContentSize.Y > comments.AbsoluteWindowSize.Y + 1
        comments.ScrollingEnabled = overflow
        comments.ScrollBarThickness = overflow and 3 or 0
        if not overflow then
            comments.CanvasPosition = Vector2.zero
        end
    end
    local resizeConnection = body:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    left.Destroying:Once(function()
        resizeConnection:Disconnect()
    end)
    stack:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateScroll)
    scroll:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(updateScroll)
    commentsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateComments)
    comments:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(updateComments)
    resize()
    updateScroll()
    updateComments()
    if data then
        return setCode
    end
end

