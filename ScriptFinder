local detailCache = {}
local detailOrder = {}
local detailPending = {}

local function requestDetails(item)
    local info = if type(item) == "table" then item else {slug = item, provider = 3}
    if not identifier(info.slug) then return nil end
    local key = tostring(info.provider == 1 and 1 or (info.provider == 2 and 2 or 3)) .. ":" .. info.slug
    local cached = detailCache[key]
    if cached and os.clock() - cached.time < 5 then
        return cached.data
    end
    if detailPending[key] then
        local deadline = os.clock() + 15
        repeat
            task.wait(0.1)
            if not alive then
                return nil
            end
        until not detailPending[key] or os.clock() >= deadline
        cached = detailCache[key]
        return cached and cached.data or nil
    end
    detailPending[key] = true
    local target = info.provider == 1 and {action = "rscriptsDetail", slug = info.slug}
        or (info.provider == 2 and {action = "haxhellDetail", slug = info.slug} or info.slug)
    local ok, data = pcall(requestData, target)
    detailPending[key] = nil
    if not ok or type(data) ~= "table" or type(data.title) ~= "string" or data.error then
        return nil
    end
    if not detailCache[key] then
        table.insert(detailOrder, key)
    end
    detailCache[key] = {time = os.clock(), data = data}
    if #detailOrder > 80 then
        detailCache[table.remove(detailOrder, 1)] = nil
    end
    return data
end

local function mergeMetadata(item, data, missingOnly)
    if not data then
        return
    end
    for _, key in ipairs({"views", "executions", "likes"}) do
        if data[key] ~= nil and (not missingOnly or item[key] == nil
            or (item.missingMetrics and item.missingMetrics[key])) then
            item[key] = data[key]
            if item.missingMetrics then item.missingMetrics[key] = nil end
        end
    end
    if data.thumbnail and data.thumbnail ~= "" then
        item.thumbnail = data.thumbnail
    end
    if data.thumbnailSource then
        item.thumbnailSource = data.thumbnailSource
    end
    for _, key in ipairs({"scriptType", "verified", "isUniversal", "createdAt", "updatedAt"}) do
        if data[key] ~= nil then item[key] = data[key] end
    end
end

local function updateCard(item, data, missingOnly)
    mergeMetadata(item, data, missingOnly)
    if data and favorites.entries[item.id] then
        local saved = favorites.clean(item)
        if saved then
            favorites.entries[item.id] = saved
            if not favorites.metadataSavePending then
                favorites.metadataSavePending = true
                task.delay(0.6, function()
                    favorites.metadataSavePending = false
                    if alive then favorites.save() end
                end)
            end
        end
    end
    local view = activeCards[item.id]
    if not view or view.item ~= item then
        return
    end
    applyImage(view.image, item.thumbnail, item.thumbnailSource, "thumbnail")
    for key, label in pairs(view.counters) do
        local value = formatCounter(item[key])
        if label.Text ~= value then
            label.Text = value
        end
    end
end

local function hydrateCards(items, token)
    local queue = {}
    for _, item in ipairs(items) do
        if not item.isGameCard and not item.isPersonCard then
            local needsMetrics = item.missingMetrics and next(item.missingMetrics) ~= nil
            if needsMetrics or (item.thumbnail == "" and not item.thumbnailSource) then
                table.insert(queue, item)
            end
        end
    end
    if #queue == 0 then return end
    local prioritized = {}
    for _, item in ipairs(queue) do
        if item.likes == nil then table.insert(prioritized, item) end
    end
    for _, item in ipairs(queue) do
        if item.likes ~= nil then table.insert(prioritized, item) end
    end
    task.spawn(function()
        local remote = ReplicatedStorage:FindFirstChild(CatalogRemote)
        local interval = (RunService:IsStudio() or (remote and remote:IsA("RemoteFunction"))) and 0.55 or 0.15
        local nextIndex, inFlight = 1, 0
        while alive and generation == token and nextIndex <= #prioritized do
            if inFlight >= 3 then
                task.wait(0.05)
            else
                local item = prioritized[nextIndex]
                nextIndex += 1
                inFlight += 1
                task.spawn(function()
                    local ok, data = pcall(requestDetails, item)
                    inFlight -= 1
                    if ok and alive and generation == token then updateCard(item, data, true) end
                end)
                if nextIndex <= #prioritized then task.wait(interval) end
            end
        end
    end)
end

