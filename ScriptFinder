local function strokePath(parent, points, thickness, color)
    for index = 1, #points - 1 do
        local a, b = points[index], points[index + 1]
        line(parent, a[1], a[2], b[1], b[2], thickness, 0, color)
    end
    for _, point in ipairs(points) do
