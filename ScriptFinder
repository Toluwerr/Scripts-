local function numericId(value)
    local n = tonumber(value)
    if n and n > 0 and n < 9007199254740992 and n == math.floor(n) then
        return string.format("%.0f", n)
    end
end

local function remoteImageUrl(value)
    if type(value) ~= "string" or #value > 1024 then
        return nil
    end
    local address = value
    if address:sub(1, 2) == "//" then
        address = "https:" .. address
    elseif address:sub(1, 1) == "/" then
        address = "https://scriptblox.com" .. address
    end
    local host, route = address:match("^https://([%w%.%-]+)(/[^%s]*)$")
    if not host or not route or route:find("..", 1, true) then
        return nil
    end
    host = host:lower()
    if host == "rscripts.net" or host == "www.rscripts.net" or host == "cdn.rscripts.net" then
        if route:match("^/assets/[%w%._%-%/]+$") or route:match("^/images/[%w%._%-%/]+$")
            or route:match("^/uploads/[%w%._%-%/]+$") then
            return "https://" .. host .. route
        end
    elseif host == "haxhell.com" or host == "www.haxhell.com" or host == "cdn.haxhell.com" then
        if route:match("^/images/[%w%._%-%/]+$") or route:match("^/uploads/[%w%._%-%/]+$")
            or route:match("^/storage/[%w%._%-%/]+$") then
            return "https://" .. host .. route
        end
    elseif host == "scriptblox.com" or host == "www.scriptblox.com" or host == "cdn.scriptblox.com" then
        if route:match("^/images/[%w%._%-%/]+$") then
            return "https://" .. host .. route
        end
    elseif host == "tr.rbxcdn.com" or host:match("^[%w%-]+%.rbxcdn%.com$") then
        if route:match("^/[%w%._%-%/]+$") then
            return address
        end
    elseif host == "cdn.discordapp.com" or host == "media.discordapp.net" then
        if route:match("^/attachments/[%w%._%-%/]+$") then
            return address
        end
    end
    return nil
end

local function imageAsset(value)
    if type(value) == "number" then
        local id = numericId(value)
        return id and ("rbxassetid://" .. id) or ""
    end
    if type(value) ~= "string" or #value > 1024 then
        return ""
    end
    if value:match("^rbxassetid://%d+$") or value:match("^rbxthumb://type=[%w]+&id=%d+&w=%d+&h=%d+$") then
        return value
    end
    local direct = value:match("^%d+$")
    if direct then
        local id = numericId(direct)
        return id and ("rbxassetid://" .. id) or ""
    end
    local host, tail = value:match("^https://([^/]+)(/[^%s]*)$")
    if not host then
        return ""
    end
    host = string.lower(host)
    if host == "www.roblox.com" or host == "roblox.com" or host == "assetdelivery.roblox.com" then
        local assetId = tail:match("^/asset/?%?id=(%d+)")
            or tail:match("^/v1/asset/?%?id=(%d+)")
        if assetId then
            return "rbxassetid://" .. assetId
        end
        local thumbId = tail:match("^/asset%-thumbnail/image%?assetId=(%d+)")
        if thumbId then
            return "rbxthumb://type=Asset&id=" .. thumbId .. "&w=420&h=420"
        end
        local userId = tail:match("^/headshot%-thumbnail/image%?userId=(%d+)")
        if userId then
            return "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
        end
    end
    if (host == "rbxcdn.com" or host:match("^[%w%-]+%.rbxcdn%.com$")) and tail:match("^/[%w%-%._/]+$") then
        return value
    end
    return ""
end

local function thumbnailFor(entry)
    local info = type(entry.game) == "table" and entry.game or {}
    local image = imageAsset(entry.image)
    if image:sub(1, 5) == "rbxas" or image:sub(1, 8) == "rbxthumb" then
        return image
    end
    local oldImage = imageAsset(info.imageUrl)
    if oldImage:sub(1, 5) == "rbxas" or oldImage:sub(1, 8) == "rbxthumb" then
        return oldImage
    end
    local id = numericId(info.placeId or entry.placeId or info.gameId)
    if id and entry.isUniversal ~= true then
        return "rbxthumb://type=GameThumbnail&id=" .. id .. "&w=384&h=216"
    end
    local universe = numericId(info.universeId or entry.universeId)
    if universe and entry.isUniversal ~= true then
        return "rbxthumb://type=GameIcon&id=" .. universe .. "&w=150&h=150"
    end
    return image ~= "" and image or oldImage
end

local function counter(...)
    for i = 1, select("#", ...) do
        local value = select(i, ...)
        local n = tonumber(value)
        if n and n >= 0 and n < 9007199254740992 then
            return math.floor(n)
        end
    end
    return nil
end

local function plainText(value, limit)
    if type(value) ~= "string" then
        return nil
    end
    value = value:gsub("\r\n", "\n"):gsub("[%z\1-\8\11\12\14-\31\127]", "")
    local len = utf8.len(value)
    if not len or len == 0 then
        return nil
    end
    if len > limit then
        value = value:sub(1, utf8.offset(value, limit + 1) - 1)
    end
    return value
end

local function identifier(value)
    return type(value) == "string" and #value > 0 and #value <= 240 and value:match("^[%w_%-]+$") ~= nil
end

local function readResponse(url, fresh)
    local body
    if RunService:IsServer() then
        body = HttpService:GetAsync(url, fresh == true, {Accept = "application/json"})
    else
        if fresh then
            local send = type(request) == "function" and request
                or (type(http_request) == "function" and http_request)
                or (syn and type(syn.request) == "function" and syn.request)
            if type(send) == "function" then
                local ok, response = pcall(send, {
                    Url = url,
                    Method = "GET",
                    Headers = {
                        Accept = "application/json",
                        ["Cache-Control"] = "no-cache",
                        Pragma = "no-cache",
                    },
                })
                if ok and type(response) == "table" then
                    local status = tonumber(response.StatusCode or response.Status or response.status_code)
                    local value = response.Body or response.body
                    if type(value) == "string" and value ~= ""
                        and (not status or (status >= 200 and status < 300)) then
                        body = value
                    elseif status then
                        local decodedOk, decoded = pcall(function()
                            return HttpService:JSONDecode(value)
                        end)
                        error(decodedOk and type(decoded) == "table" and plainText(decoded.message, 160)
                            or ("HTTP " .. tostring(status)), 0)
                    end
                end
            end
        end
        if not body then
            body = game:HttpGet(url)
        end
    end
    if type(body) ~= "string" or body == "" then
        error("Empty ScriptBlox response", 0)
    end
    local decoded = HttpService:JSONDecode(body)
    if type(decoded) ~= "table" then
        error("Invalid ScriptBlox response", 0)
    end
    if type(decoded.message) == "string" and not decoded.result and not decoded.script and not decoded.data then
        error(plainText(decoded.message, 160) or "ScriptBlox request failed", 0)
    end
    return decoded
end

local Filters = {
    groups = {
        {key = "sort", title = "Sort by", options = {
            {"all", "Default"}, {"newest", "Newest"}, {"updated", "Recently updated"},
            {"views", "Most viewed"}, {"likes", "Most liked"},
        }},
        {key = "cost", title = "Type", options = {
            {"all", "All types"}, {"free", "Free"}, {"paid", "Paid"},
        }},
        {key = "verification", title = "Verification", options = {
            {"all", "Any"}, {"verified", "Verified"}, {"unverified", "Unverified"},
        }},
        {key = "scope", title = "Scope", options = {
            {"all", "Any"}, {"universal", "Universal"}, {"game", "Game-specific"},
        }},
    },
    sorts = {newest = "createdAt", updated = "updatedAt", views = "views", likes = "likeCount"},
}

function Filters.normalize(value)
    if value ~= nil and type(value) ~= "table" then return nil end
    local result = {}
    for _, group in ipairs(Filters.groups) do
        local selected = value and value[group.key] or "all"
        local valid = false
        for _, option in ipairs(group.options) do
            if selected == option[1] then
                valid = true
                break
            end
        end
        if not valid then return nil end
        result[group.key] = selected
    end
    return result
end

function Filters.key(value)
    local parts = {}
    for _, group in ipairs(Filters.groups) do
        table.insert(parts, value[group.key])
    end
    return table.concat(parts, ":")
end

function Filters.count(value)
    local count = 0
    for _, group in ipairs(Filters.groups) do
        if value[group.key] ~= "all" then count += 1 end
    end
    return count
end

function Filters.matches(item, value)
    if value.cost ~= "all" and item.scriptType ~= value.cost then return false end
    if value.verification ~= "all" and item.verified ~= (value.verification == "verified") then return false end
    if value.scope ~= "all" and item.isUniversal ~= (value.scope == "universal") then return false end
    return true
end

function Filters.metadata(item)
    return {
        scriptType = (item.scriptType == "free" or item.scriptType == "paid") and item.scriptType or nil,
        verified = if type(item.verified) == "boolean" then item.verified else nil,
        isUniversal = if type(item.isUniversal) == "boolean" then item.isUniversal else nil,
        createdAt = plainText(item.createdAt, 64),
        updatedAt = plainText(item.updatedAt, 64),
    }
end

local function summaryFor(item)
    local title = plainText(item.title, 180)
    local id = item._id or item.slug
    if not title or not identifier(id) then
        return nil
    end
    local stats = type(item.stats) == "table" and item.stats or {}
    local experience = type(item.game) == "table" and item.game or {}
    local metadata = Filters.metadata(item)
    return {
        placeId = numericId(experience.placeId or item.placeId or experience.gameId),
        gameName = plainText(experience.name or experience.title or experience.gameName, 140),
        scriptType = metadata.scriptType,
        verified = metadata.verified,
        isUniversal = metadata.isUniversal,
        createdAt = metadata.createdAt,
        updatedAt = metadata.updatedAt,
        id = id,
        slug = identifier(item.slug) and item.slug or id,
        title = title:gsub("\n", " "),
        thumbnail = thumbnailFor(item),
        thumbnailSource = remoteImageUrl(item.image) or remoteImageUrl(type(item.game) == "table" and item.game.imageUrl),
        views = counter(item.views, item.viewCount, stats.views),
        executions = counter(item.executeCount, item.executionCount, item.executions, item.executes, item.totalExecutions, stats.executions),
        likes = counter(item.likeCount, item.likesCount, item.likes, stats.likeCount, stats.likesCount, stats.likes),
    }
end

local function normalizeSearch(value)
    local query = plainText(value, 120)
    return query and query:match("^%s*(.-)%s*$") or ""
end

local function fetchCatalogue(target, placeId, query, filters)
    query = normalizeSearch(query)
    filters = Filters.normalize(filters)
    if not filters then error("Invalid filters", 0) end
    local sort = Filters.sorts[filters.sort] or (query ~= "" and "accuracy" or "updatedAt")
    local url
    if query ~= "" then
        url = string.format("https://scriptblox.com/api/script/search?q=%s&page=%d&max=%d&strict=false",
            HttpService:UrlEncode(query), target, PageSize)
    else
        url = string.format("https://scriptblox.com/api/script/fetch?page=%d&max=%d", target, PageSize)
    end
    url ..= "&sortBy=" .. sort .. "&order=desc"
    if filters.cost ~= "all" then url ..= "&mode=" .. filters.cost end
    if filters.verification ~= "all" then
        url ..= "&verified=" .. (filters.verification == "verified" and "1" or "0")
    end
    if filters.scope ~= "all" then
        url ..= "&universal=" .. (filters.scope == "universal" and "1" or "0")
    end
    if placeId ~= nil then
        local id = numericId(placeId)
        if not id then
            error("Current place is unavailable", 0)
        end
        url ..= "&placeId=" .. id
    end
    local decoded = readResponse(url, true)
    local result = decoded.result
    if type(result) ~= "table" or type(result.scripts) ~= "table" then
        error("Invalid catalogue response", 0)
    end
    local total = tonumber(result.totalPages)
    if not total or total ~= total or total < 0 or total > 1000000 then
        error("Invalid page count", 0)
    end
    local items = {}
    for _, item in ipairs(result.scripts) do
        if #items >= PageSize then
            break
        end
        if type(item) == "table" then
            local summary = summaryFor(item)
            if summary then
                summary.missingMetrics = {}
                for _, field in ipairs({"views", "executions", "likes"}) do
                    if summary[field] == nil then
                        summary.missingMetrics[field] = true
                    end
                end
                table.insert(items, summary)
            end
        end
    end
    return {totalPages = math.max(1, math.floor(total)), items = items}
end

local function haxhellSummary(item)
    if type(item) ~= "table" then return nil end
    local slug = item.slug
    local sourceId = identifier(item.id) and item.id or slug
    if not identifier(slug) or not identifier(sourceId) then return nil end
    local title = plainText(item.title, 180)
    if not title then return nil end
    local experience = type(item.game) == "table" and item.game or {}
    local author = type(item.author) == "table" and item.author or {}
    local stats = type(item.stats) == "table" and item.stats or {}
    local flags = type(item.flags) == "table" and item.flags or {}
    local media = type(item.media) == "table" and item.media or {}
    local placeId = numericId(experience.placeId)
    local universeId = numericId(experience.universeId)
    local thumbnail = ""
    if item.type ~= "universal" then
        if placeId then
            thumbnail = "rbxthumb://type=GameThumbnail&id=" .. placeId .. "&w=384&h=216"
        elseif universeId then
            thumbnail = "rbxthumb://type=GameIcon&id=" .. universeId .. "&w=150&h=150"
        end
    end
    return {
        id = "hh_" .. sourceId, provider = 2, slug = slug,
        title = title:gsub("\n", " "),
        thumbnail = thumbnail,
        thumbnailSource = remoteImageUrl(media.thumbnailUrl)
            or remoteImageUrl(experience.thumbnailUrl) or remoteImageUrl(experience.iconUrl),
        author = plainText(author.username, 100),
        avatarSource = remoteImageUrl(author.avatar),
        avatar = imageAsset(author.avatar),
        description = plainText(item.description, 8000),
        placeId = placeId,
        gameName = plainText(experience.name or experience.gameName or experience.title, 140),
        scriptType = flags.isPaid == true and "paid" or "free",
        isUniversal = item.type == "universal",
        verified = if type(flags.verified) == "boolean" then flags.verified
            else author.isScripterVerified == true,
        views = counter(stats.views), likes = counter(stats.likes, stats.likeCount, item.likeCount, item.likes),
        executions = nil, commentsCount = counter(stats.comments),
        favoritesCount = counter(stats.favorites),
        createdAt = plainText(item.createdAt, 64),
        updatedAt = plainText(item.updatedAt, 64),
    }
end

