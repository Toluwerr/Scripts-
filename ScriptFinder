local function loadCatalogue(target, direction, background)
    if not alive or loading or target < 1 or (totalPages and target > totalPages) then
        return
    end
    generation += 1
    local token = generation
    local scope = catalogueScope
    local provider = selectedProvider
    local query = searchState.query
    local filters = table.clone(filterState.values)
    local filterKey = Filters.key(filters)
    loading = true
    retryPage = nil
    feedback.Visible = not activePageView
    feedback.BackgroundTransparency = 1
    feedback.Text = "Loading..."
    updatePagination()
    task.spawn(function()
        lastCatalogueRequest = os.clock()
        local ok, data
        if scope == "people" then
            ok, data = pcall(requestData, {action = "peopleSearch", query = query,
                cursor = filterState.peopleCursors[target] or ""})
            if ok and type(data) == "table" and type(data.items) == "table" then
                for _, person in ipairs(data.items) do People.applyLocalPresence(person) end
                local nextCursor = data.nextCursor
                local hasNext = type(nextCursor) == "string" and nextCursor ~= ""
                    and nextCursor ~= filterState.peopleCursors[target]
                data.totalPages = target + (hasNext and 1 or 0)
            end
        elseif scope == "games" then
            ok, data = pcall(requestData, {action = "robloxGames", page = target, query = query})
        elseif scope == "favorites" then
            ok, data = pcall(favorites.page, target, query, filters, provider)
        elseif provider == 1 then
            ok, data = pcall(requestData, {action = "rscripts", page = target,
                query = query, filters = filters, gameOnly = scope == "game"})
        elseif provider == 2 then
            ok, data = pcall(requestData, {action = "haxhell", page = target,
                query = query, filters = filters, gameOnly = scope == "game"})
        elseif Filters.count(filters) > 0 then
            ok, data = pcall(requestData, {action = "filtered", page = target, query = query,
                gameOnly = scope == "game", filters = filters})
        elseif query ~= "" then
            ok, data = pcall(requestData, {action = "search", page = target, query = query, gameOnly = scope == "game"})
        elseif scope == "game" then
            ok, data = pcall(requestData, {action = "game", page = target})
        else
            ok, data = pcall(requestData, target)
        end
        if not alive or token ~= generation
            or (scope ~= "games" and scope ~= "people" and selectedProvider ~= provider)
            or scope ~= catalogueScope or query ~= searchState.query
            or (scope ~= "games" and scope ~= "people" and filterKey ~= Filters.key(filterState.values)) then
            return
        end
        loading = false
        if not ok or type(data) ~= "table" or type(data.items) ~= "table" or type(data.totalPages) ~= "number" then
            retryPage = target
            local reason = not ok and tostring(data) or (type(data) == "table" and data.error or "Invalid catalogue response")
            reason = tostring(reason):gsub("[%c]", " ")
            warn("ScriptFinder catalogue: " .. reason)
            feedback.Text = ((scope == "games" or scope == "people") and "Roblox: " or scope == "favorites" and "Favorites: "
                or (provider == 1 and "RScripts: " or (provider == 2 and "HaxHell: " or "ScriptBlox: ")))
                .. string.sub(reason, 1, 180)
            feedback.Visible = not background or not activePageView
            feedback.BackgroundTransparency = activePageView and 0.1 or 1
            updatePagination()
            return
        end
        gui:SetAttribute("LastCatalogueUpdate", os.time())
        totalPages = math.max(1, math.floor(data.totalPages))
        if target > totalPages then
            updatePagination()
            loadCatalogue(totalPages, -1)
            return
        end
        page = target
        if scope == "people" then
            filterState.peopleCursors[target + 1] = data.totalPages > target and data.nextCursor or nil
        end
        if scope == "favorites" then favorites.dirty = false end
        hasLoaded = true
        gui:SetAttribute("Page", page)
        gui:SetAttribute("TotalPages", totalPages)
        feedback.Visible = #data.items == 0
        local empty = data.insufficientQuery and "Enter at least two characters to search HaxHell."
            or (scope == "games" and "No games found.")
            or (scope == "people" and "No people found.")
            or (query ~= "" and "No matching scripts.")
            or (scope == "favorites" and "No favorites yet.")
            or (scope == "game" and "No scripts found for this game." or "No scripts on this page.")
        feedback.Text = #data.items == 0 and empty or ""
        presentPage(data.items, direction, target)
        updatePagination()
        hydrateCards(data.items, token)
    end)
end

requestFreshCatalogue = function(interval)
    if catalogueScope == "people" then return end
    if not alive or loading or detailView
        or not content.Visible or not results.Visible
        or filterState.pending or normalizeSearch(searchInput.Text) ~= searchState.query then
        return
    end
    if not activePageView and not retryPage then
        return
    end
    if catalogueScope == "favorites" then
        if favorites.dirty or retryPage then
            loadCatalogue(math.min(page, math.max(1, math.ceil(#favorites.order / PageSize))), 0)
        end
        return
    end
    if os.clock() - lastCatalogueRequest < (interval or 6) then
        return
    end
    loadCatalogue(retryPage or page, 0, true)
end

function settings.scheduleRefresh()
    settings.refreshTicket = (settings.refreshTicket or 0) + 1
    local ticket = settings.refreshTicket
    if not alive or not settings.values.liveRefresh or not content.Visible then
        return
    end
    local delaySeconds = retryPage and 60 or 30
    task.delay(delaySeconds, function()
