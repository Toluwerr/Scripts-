    stopDotTween()
    dotTween = TweenService:Create(window, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundColor3 = active and Theme.Accent:Lerp(Theme.Text, 0.14) or Theme.Accent,
    })
    dotTween:Play()
end

