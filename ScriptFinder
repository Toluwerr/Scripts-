local function presentPage(items, direction, target)
    if activePageView and displayedPage == target then
        reconcileCards(activePageView.Cards, items)
        return
    end
    clearPageMotion()
    local old = activePageView
    local incoming = makePage(items)
    activePageView = incoming
    displayedPage = target
    if not old or direction == 0 then
        if old then
            old:Destroy()
        end
        incoming.Position = UDim2.fromOffset(0, 0)
        return
    end
    incoming.Position = UDim2.fromScale(direction, 0)
    local info = TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local show = TweenService:Create(incoming, info, {Position = UDim2.fromOffset(0, 0)})
    table.insert(pageMotion, show)
    outgoingPageView = old
    local hide = TweenService:Create(old, info, {Position = UDim2.fromScale(-direction, 0)})
    table.insert(pageMotion, hide)
    hide.Completed:Once(function()
        if outgoingPageView == old then
            outgoingPageView = nil
            old:Destroy()
        end
    end)
    hide:Play()
    show:Play()
end

local function requestData(target)
    local remote = ReplicatedStorage:FindFirstChild(CatalogRemote)
    if RunService:IsStudio() then
        remote = remote or ReplicatedStorage:WaitForChild(CatalogRemote, 8)
        if not remote or not remote:IsA("RemoteFunction") then
            error("Studio requires the ScriptFinderCatalog server script and HTTP requests enabled", 0)
        end
        return remote:InvokeServer(target)
    end
    if remote and remote:IsA("RemoteFunction") then
        return remote:InvokeServer(target)
    end
    if type(target) == "table" and target.action == "robloxGames" then
        return fetchRobloxGames(target.page, target.query)
    end
    if type(target) == "table" and target.action == "peopleSearch" then
        return People.search(target.query, target.cursor)
    end
    if type(target) == "table" and target.action == "peopleProfile" then
        return People.profile(target.userId)
    end
    if type(target) == "table" and target.action == "comments" then
        return fetchComments(target.id, target.page)
    end
    if type(target) == "table" and target.action == "code" then
        return fetchCode(target.id)
    end
    if type(target) == "table" and target.action == "rscripts" then
        return fetchRScriptsCatalogue(target.page, target.query, target.filters, target.gameOnly)
    end
    if type(target) == "table" and target.action == "rscriptsDetail" then
        return fetchRScriptsDetails(target.slug)
    end
    if type(target) == "table" and target.action == "haxhell" then
        return fetchHaxHellCatalogue(target.page, target.query, target.filters, target.gameOnly)
    end
    if type(target) == "table" and target.action == "haxhellDetail" then
        return fetchHaxHellDetails(target.slug)
    end
    if type(target) == "table" and target.action == "haxhellCode" then
        return fetchHaxHellCode(target.slug)
    end
    if type(target) == "table" and target.action == "filtered" then
        return fetchCatalogue(target.page, target.gameOnly and game.PlaceId or nil, target.query, target.filters)
    end
    if type(target) == "table" and target.action == "search" then
