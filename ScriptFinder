        loadCatalogue(page, 0)
    end
end)

bind(UserInputService.WindowFocused, function()
    if alive and mode ~= "dot" and mode ~= "closed" and settings.values.refreshOnFocus then
        requestFreshCatalogue(2)
    end
end)

bind(UserInputService.InputBegan, function(input)
    if not alive or not results.Visible or detailView or filterState.expanded
        or (input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch) then
        return
    end
    local p = input.Position
    local origin, extent = results.AbsolutePosition, results.AbsoluteSize
    if p.X >= origin.X and p.X <= origin.X + extent.X
        and p.Y >= origin.Y and p.Y <= origin.Y + extent.Y then
        requestFreshCatalogue(6)
    end
end)

bind(minimizeButton.Activated, function()
    setMode("dot")
end)

bind(maximizeButton.Activated, function()
    setMode(mode == "fullscreen" and "normal" or "fullscreen")
end)

bind(closeButton.Activated, function()
    setMode("closed")
end)

bind(gui.Destroying, function()
    alive = false
    detailGeneration += 1
    if detailMotion then
        detailMotion:Cancel()
        detailMotion = nil
    end
    generation += 1
    for _, tween in ipairs(pageMotion) do
        tween:Cancel()
    end
    table.clear(pageMotion)
    gesture = nil
    selectorGesture = nil
    stopSelectorTween()
    cancelMotion()
    stopDotTween()
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    for _, tween in pairs(hoverTweens) do
        tween:Cancel()
    end
    table.clear(connections)
    table.clear(hoverTweens)
end)

selectProvider(selectedProvider, false)
switchCatalogue(settings.values.startInFavorites and "favorites" or "all")
updatePagination()
render()
settings.scheduleRefresh()
