local function fetchRScriptsCatalogue(page, query, filters, gameOnly)
    if type(page) ~= "number" or page ~= math.floor(page) or page < 1 or page > 200 then
        error("Invalid RScripts page", 0)
    end
    filters = Filters.normalize(filters)
    if not filters then error("Invalid RScripts filters", 0) end
    query = normalizeSearch(query)
    if #query > 100 then query = query:sub(1, 100) end
    local sort = ({all = "newest", newest = "newest", views = "most-views",
        likes = "most-likes"})[filters.sort] or "newest"
    local route = "scripts?page=" .. tostring(page) .. "&limit=" .. PageSize .. "&sort=" .. sort
    if query ~= "" then route ..= "&q=" .. HttpService:UrlEncode(query) end
    if gameOnly then
        local place = numericId(game.PlaceId)
        if not place then error("Current place unavailable", 0) end
        route ..= "&placeId=" .. place
    end
    if filters.cost == "free" then route ..= "&freeOnly=true" end
    if filters.verification == "verified" then route ..= "&verifiedOnly=true" end
    local response = rscriptsFetch(route)
    if type(response.data) ~= "table" or type(response.meta) ~= "table" then
        error("Invalid RScripts catalogue response", 0)
    end
    local pages = tonumber(response.meta.totalPages)
    if not pages or pages ~= pages or pages < 0 or pages > 1000000 then
        error("Invalid RScripts pagination", 0)
    end
    local items = {}
    for _, raw in ipairs(response.data) do
        if #items >= PageSize then break end
        local item = rscriptsSummary(raw)
        if item then
            item.missingMetrics = item.likes == nil and {likes = true} or {}
            table.insert(items, item)
        end
    end
    return {items = items, totalPages = math.max(1, math.min(200, math.floor(pages)))}
end

local function fetchRScriptsDetails(slug)
    if not identifier(slug) then error("Invalid RScripts slug", 0) end
    local response = rscriptsFetch("scripts/" .. HttpService:UrlEncode(slug))
    local item = rscriptsSummary(response.data)
    if not item then error("Invalid RScripts details", 0) end
    return item
end

local function normalizeComments(comments)
    local entries = {}
    for _, comment in ipairs(comments) do
        if #entries >= 20 then
            break
        end
        if type(comment) == "table" then
            local author = type(comment.commentBy) == "table" and comment.commentBy
                or type(comment.owner) == "table" and comment.owner
                or type(comment.author) == "table" and comment.author or {}
            local message = plainText(comment.text, 1000) or plainText(comment.content, 1000) or plainText(comment.message, 1000)
            if message then
                table.insert(entries, {
                    id = identifier(comment._id) and comment._id or nil,
                    author = plainText(author.username, 100),
                    text = message,
                    createdAt = plainText(comment.createdAt, 64),
                    likes = counter(comment.likeCount),
                })
            end
        end
    end
    return entries
end

local function fetchComments(id, target)
    if not identifier(id) or type(target) ~= "number" or target < 1
        or target > 10000 or target ~= math.floor(target) then
        error("Invalid comments request", 0)
    end
    local url = "https://scriptblox.com/api/comment/" .. HttpService:UrlEncode(id)
        .. string.format("?page=%d&max=20", target)
    local decoded = readResponse(url)
    local result = decoded.result
    if type(result) ~= "table" or type(result.comments) ~= "table" then
        error("Invalid comments response", 0)
    end
    local pages = counter(result.totalPages)
    return {
        comments = normalizeComments(result.comments),
        totalPages = pages and math.max(1, math.min(10000, pages)) or target,
    }
end

local function fetchCode(id)
    if not identifier(id) then
        error("Invalid source identifier", 0)
    end
    local url = "https://scriptblox.com/api/script/raw/" .. HttpService:UrlEncode(id)
    local ok, source = pcall(function()
        if RunService:IsServer() then
            return HttpService:GetAsync(url, true, {Accept = "text/plain"})
        end
        return game:HttpGet(url)
    end)
    local function sourceIsValid(value)
        return type(value) == "string" and #value > 0 and #value <= 350000
            and not value:match("^%s*<")
            and not value:match('^%s*{"')
            and value:find("%S") ~= nil
    end
    if not ok or not sourceIsValid(source) then
        local decoded = readResponse("https://scriptblox.com/api/script/" .. HttpService:UrlEncode(id))
        local item = decoded.script
        if type(item) == "table" then
            source = item.script or item.source or item.code
        end
    end
    if not sourceIsValid(source) then
        error("Script source unavailable or exceeds limit", 0)
    end
    return {source = source}
end

local function fetchDetails(slug)
    if not identifier(slug) then
        error("Invalid script identifier", 0)
    end
    local decoded = readResponse("https://scriptblox.com/api/script/" .. HttpService:UrlEncode(slug), true)
    local item = decoded.script
    if type(item) ~= "table" then
        error("Invalid script details", 0)
    end
    local info = summaryFor(item)
    if not info then
        error("Invalid script metadata", 0)
    end
    local owner = type(item.owner) == "table" and item.owner or {}
    info.author = plainText(owner.username, 100)
    info.avatarSource = remoteImageUrl(owner.profilePicture) or remoteImageUrl(owner.avatarUrl) or remoteImageUrl(owner.avatar)
    info.avatar = imageAsset(owner.profilePicture)
    if info.avatar == "" then
        info.avatar = imageAsset(owner.profilePictureAssetId or owner.avatarAssetId)
    end
    if info.avatar == "" then
        info.avatar = imageAsset(owner.avatarUrl or owner.avatar)
    end
    local userId = numericId(owner.robloxUserId or owner.robloxId)
    if info.avatar == "" and userId then
        info.avatar = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
    end
    info.level = counter(owner.level, owner.userLevel)
    info.createdAt = plainText(item.createdAt, 64)
    info.bumpedAt = plainText(item.bumpedAt, 64) or plainText(item.lastBumpedAt, 64)
    if type(item.isBumped) == "boolean" then
        info.bumped = item.isBumped
    elseif type(item.bumped) == "boolean" then
        info.bumped = item.bumped
    elseif info.bumpedAt then
        info.bumped = true
    end
    info.description = plainText(item.description, 8000) or plainText(item.features, 8000)
    local comments = type(item.comments) == "table" and item.comments or decoded.comments
    if type(comments) == "table" then
        info.comments = normalizeComments(comments)
    end
    return info
end

local fetchRobloxGames
do
    local snapshots = {}
    local order = {}
    local maxGames = 100

    local function collectGames(value, ids, seen, depth)
        if type(value) ~= "table" or depth > 12 or #ids >= maxGames then return end
        local id = numericId(value.universeId)
        if id and not seen[id] then
            seen[id] = true
            table.insert(ids, id)
        end
        for _, child in ipairs(value) do
            collectGames(child, ids, seen, depth + 1)
        end
        for key, child in pairs(value) do
            if type(key) ~= "number" and type(child) == "table" then
                collectGames(child, ids, seen, depth + 1)
            end
        end
    end

    local function discover(query)
        local session = HttpService:GenerateGUID(false)
        local url = query == "" and ("https://apis.roblox.com/explore-api/v1/get-sort-content?sortId=top-playing-now&device=computer&country=all&sessionId=" .. session)
            or ("https://apis.roblox.com/search-api/omni-search?pageType=all&sessionId=" .. session .. "&searchQuery=" .. HttpService:UrlEncode(query))
        local ids, seen, cursors = {}, {}, {}
        local cursor
        for _ = 1, (query == "" and 1 or 5) do
            local address = url
            if cursor then address ..= "&pageToken=" .. HttpService:UrlEncode(cursor) end
            local ok, response = pcall(readResponse, address, true)
            if not ok then
                if #ids == 0 then error(response, 0) end
                break
            end
            if query ~= "" then
                if type(response.searchResults) ~= "table" then
                    if #ids == 0 then error("Invalid Roblox search response", 0) end
                    break
                end
                collectGames(response.searchResults, ids, seen, 0)
            else
                collectGames(response, ids, seen, 0)
                if #ids == 0 and not (response.games or response.sorts or response.sortContent or response.content or response.data or response.gameSorts) then
                    error("Invalid Roblox discovery response", 0)
                end
            end
            cursor = response.nextPageToken
            if query == "" or #ids >= maxGames or type(cursor) ~= "string" or cursor == "" or #cursor > 4096 or cursors[cursor] then break end
            cursors[cursor] = true
        end

        local all = {}
        for first = 1, #ids, 50 do
            local batch = {}
            for i = first, math.min(first + 49, #ids) do table.insert(batch, ids[i]) end
            local details = readResponse("https://games.roblox.com/v1/games?universeIds=" .. table.concat(batch, ","), true)
            if type(details.data) ~= "table" then error("Invalid Roblox game metadata", 0) end
            for _, info in ipairs(details.data) do
                if type(info) == "table" then
                    local universe = numericId(info.id)
                    local place = numericId(info.rootPlaceId)
                    local title = plainText(info.name, 180)
                    if universe and place and title and seen[universe] then
                        all[universe] = {
                            id = "game_" .. universe, isGameCard = true, universeId = universe,
                            placeId = place, title = title,
                            thumbnail = "rbxthumb://type=GameThumbnail&id=" .. place .. "&w=384&h=216",
                        }
                    end
                end
            end
        end
        local ordered = {}
        for _, id in ipairs(ids) do
            if all[id] then table.insert(ordered, all[id]) end
        end
        return ordered
    end

    fetchRobloxGames = function(target, query)
        query = normalizeSearch(query)
        local snapshot = snapshots[query]
        if not snapshot or (target == 1 and os.clock() - snapshot.time >= 30)
            or os.clock() - snapshot.time >= 180 then
            local items = discover(query)
            if not snapshots[query] then
                table.insert(order, query)
                if #order > 12 then snapshots[table.remove(order, 1)] = nil end
            end
            snapshot = {items = items, time = os.clock()}
            snapshots[query] = snapshot
        end
        local items = {}
        for i = (target - 1) * PageSize + 1, math.min(target * PageSize, #snapshot.items) do
            table.insert(items, table.clone(snapshot.items[i]))
        end
        return {items = items, totalPages = math.max(1, math.ceil(#snapshot.items / PageSize))}
    end
end

local People = {}

function People.summary(raw)
    if type(raw) ~= "table" then return nil end
    local id = numericId(raw.id)
    local username = plainText(raw.name, 64)
    if not id or not username then return nil end
    return {
        id = "person_" .. id, userId = id, isPersonCard = true,
        username = username, title = plainText(raw.displayName, 80) or username,
        thumbnail = "rbxthumb://type=AvatarHeadShot&id=" .. id .. "&w=150&h=150",
        verified = if type(raw.hasVerifiedBadge) == "boolean" then raw.hasVerifiedBadge else nil,
        presence = "Unknown",
    }
end

function People.presence(items)
    if #items == 0 then return end
    local ids, indexed = {}, {}
    for _, item in ipairs(items) do
        table.insert(ids, tonumber(item.userId))
        indexed[item.userId] = item
    end
    local ok, response = pcall(function()
        local body = HttpService:JSONEncode({userIds = ids})
        local url = "https://presence.roblox.com/v1/presence/users"
        local payload
        if RunService:IsServer() then
            payload = HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson, false)
        else
            local send = type(request) == "function" and request
                or (type(http_request) == "function" and http_request)
                or (syn and type(syn.request) == "function" and syn.request)
            if not send then return nil end
            local reply = send({
                Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json", Accept = "application/json"},
                Body = body,
            })
            if type(reply) ~= "table" then return nil end
            local status = tonumber(reply.StatusCode or reply.Status or reply.status_code)
            if status and (status < 200 or status >= 300) then return nil end
            payload = reply.Body or reply.body
        end
        if type(payload) ~= "string" then return nil end
        return HttpService:JSONDecode(payload)
    end)
    if not ok or type(response) ~= "table" or type(response.userPresences) ~= "table" then return end
    for _, record in ipairs(response.userPresences) do
        if type(record) == "table" then
            local item = indexed[numericId(record.userId) or ""]
            if item then
                local kind = tonumber(record.userPresenceType)
                item.presence = ({[0] = "Offline", [1] = "Online", [2] = "In game", [3] = "In Studio", [4] = "Unknown"})[kind or -1] or "Unknown"
                if kind == 2 then
                    item.visibleUniverse = numericId(record.universeId)
                    local location = plainText(record.lastLocation, 120)
                    if location and location:match("%S") then
                        local normalized = location:lower():match("^%s*(.-)%s*$")
                        local generic = {["playing"] = true, ["in game"] = true, ["in-game"] = true,
                            ["website"] = true, ["roblox"] = true, ["unknown"] = true,
                            ["playing a game"] = true, ["playing an experience"] = true,
                            ["private"] = true, ["hidden"] = true, ["offline"] = true}
                        if not generic[normalized] then item.currentGame = location end
                    end
                    if not item.visibleUniverse and not item.currentGame then
                        item.visiblePlace = numericId(record.rootPlaceId) or numericId(record.placeId)
                    end
                end
            end
        end
    end
    local resolvedPlaces, pendingPlaces = {}, {}
    local pending = 0
    for _, item in ipairs(items) do
        local place = item.visiblePlace
        if place and not pendingPlaces[place] then
            pendingPlaces[place] = true
            pending += 1
            task.spawn(function()
                local ok, response = pcall(readResponse, "https://apis.roblox.com/universes/v1/places/" .. place .. "/universe", true)
                if ok and type(response) == "table" then
                    resolvedPlaces[place] = numericId(response.universeId)
                end
                pending -= 1
            end)
        end
    end
    local deadline = os.clock() + 3
    while pending > 0 and os.clock() < deadline do task.wait(0.05) end
    local universes, seen = {}, {}
    for _, item in ipairs(items) do
        item.visibleUniverse = item.visibleUniverse or (item.visiblePlace and resolvedPlaces[item.visiblePlace])
        item.visiblePlace = nil
        local id = item.visibleUniverse
        if id and not seen[id] then
            seen[id] = true
            table.insert(universes, id)
        end
    end
    if #universes > 0 then
        local success, games = pcall(readResponse, "https://games.roblox.com/v1/games?universeIds=" .. table.concat(universes, ","), true)
        if success and type(games) == "table" and type(games.data) == "table" then
            local names = {}
            for _, entry in ipairs(games.data) do
                if type(entry) == "table" then
                    local id = numericId(entry.id)
                    if id and seen[id] then names[id] = plainText(entry.name, 140) end
                end
            end
            for _, item in ipairs(items) do
                if item.visibleUniverse and names[item.visibleUniverse] then
                    item.currentGame = names[item.visibleUniverse]
                end
            end
        end
    end
    -- No location or server identifiers are retained for other users.
    for _, item in ipairs(items) do item.visibleUniverse = nil end
end

function People.search(query, cursor)
    query = normalizeSearch(query)
    if query == "" then return {items = {}, nextCursor = ""} end
    if type(cursor) ~= "string" or #cursor > 2048 then error("Invalid people search cursor", 0) end
    local url = "https://users.roblox.com/v1/users/search?limit=25&keyword=" .. HttpService:UrlEncode(query)
    if cursor ~= "" then url ..= "&cursor=" .. HttpService:UrlEncode(cursor) end
    local data = readResponse(url, true)
    if type(data.data) ~= "table" then error("Invalid Roblox user search response", 0) end
    local items, seen = {}, {}
    for _, raw in ipairs(data.data) do
        if #items >= 25 then break end
        local item = People.summary(raw)
        if item and not seen[item.userId] then
            seen[item.userId] = true
            table.insert(items, item)
        end
    end
    People.presence(items)
    local nextCursor = data.nextPageCursor
    return {items = items, nextCursor = type(nextCursor) == "string" and #nextCursor <= 2048 and nextCursor or ""}
end

function People.profile(userId)
    local id = numericId(userId)
    if not id then error("Invalid user ID", 0) end
    local raw = readResponse("https://users.roblox.com/v1/users/" .. id, true)
    local item = People.summary(raw)
    if not item or item.userId ~= id then error("Invalid Roblox profile", 0) end
    item.description = plainText(raw.description, 5000) or ""
    item.created = plainText(raw.created, 64)
    item.isBanned = if type(raw.isBanned) == "boolean" then raw.isBanned else nil
    if item.created then
        local ok, date = pcall(DateTime.fromIsoDate, item.created)
        if ok and date then
            local days = math.floor((DateTime.now().UnixTimestamp - date.UnixTimestamp) / 86400)
            if days >= 0 then item.accountDays = days end
        end
    end
    local routes = {connections = "friends", followers = "followers", following = "followings"}
    local remaining = 0
    local function run(callback)
        remaining += 1
        task.spawn(function()
            pcall(callback)
            remaining -= 1
        end)
    end
    run(function() People.presence({item}) end)
    for field, route in pairs(routes) do
        run(function()
            local data = readResponse("https://friends.roblox.com/v1/users/" .. id .. "/" .. route .. "/count", true)
            if type(data) == "table" then item[field] = counter(data.count) end
        end)
    end
    run(function()
        local data = readResponse("https://games.roblox.com/v2/users/" .. id .. "/games?accessFilter=Public&limit=50&sortOrder=Desc", true)
        if type(data.data) ~= "table" then return end
        local games, count, visits, completeVisits = {}, 0, 0, true
        for _, entry in ipairs(data.data) do
            if type(entry) == "table" then
                local universe, name = numericId(entry.id), plainText(entry.name, 140)
                if universe and name then
                    count += 1
                    local value = counter(entry.placeVisits)
                    if value == nil then completeVisits = false else visits += value end
                    if #games < 6 then table.insert(games, {name = name, visits = value,
                        thumbnail = "rbxthumb://type=GameIcon&id=" .. universe .. "&w=150&h=150"}) end
                end
            end
        end
        item.publicGames = games
        item.gameCount = count
        item.gamesPartial = type(data.nextPageCursor) == "string" and data.nextPageCursor ~= ""
        if completeVisits then item.gameVisits = visits end
    end)
    run(function()
        local data = readResponse("https://accountinformation.roblox.com/v1/users/" .. id .. "/roblox-badges", true)
        if type(data) ~= "table" or data.errors then return end
        local badges = {}
        for _, badge in ipairs(data) do
            if type(badge) == "table" then
                local name = plainText(badge.name, 80)
                if name then table.insert(badges, name) end
            end
            if #badges >= 20 then break end
        end
        item.platformBadges = badges
    end)
    local deadline = os.clock() + 8
    while remaining > 0 and os.clock() < deadline do task.wait(0.05) end
    return table.clone(item)
end

function People.statusText(item)
    if item.presence == "In game" then
        return item.currentGame or "In game (game unavailable)"
    end
    if item.presence == "Offline" then return "Offline / hidden" end
    return item.presence == "Unknown" and "Status unavailable" or (item.presence or "Status unavailable")
end

function People.statusColor(item)
    if item.presence == "In game" then return Color3.fromRGB(2, 183, 87) end
    if item.presence == "Online" then return Color3.fromRGB(0, 162, 255) end
    if item.presence == "In Studio" then return Color3.fromRGB(228, 174, 83) end
    return Color3.fromRGB(148, 148, 148)
end

if RunService:IsServer() then
    local remote = ReplicatedStorage:FindFirstChild(CatalogRemote)
    if not remote then
        remote = Instance.new("RemoteFunction")
        remote.Name = CatalogRemote
        remote.Parent = ReplicatedStorage
    end
    assert(remote:IsA("RemoteFunction"), "Invalid catalogue remote")
    local cache, order, recent, pending = {}, {}, {}, {}
    local windowStart, requests = os.clock(), 0
    remote.OnServerInvoke = function(player, target)
        local isRobloxGames = type(target) == "table" and target.action == "robloxGames"
        local isPeople = type(target) == "table" and target.action == "peopleSearch"
        local isProfile = type(target) == "table" and target.action == "peopleProfile"
        local isComments = type(target) == "table" and target.action == "comments"
        local isCode = type(target) == "table" and target.action == "code"
        local isGame = type(target) == "table" and target.action == "game"
        local isSearch = type(target) == "table" and target.action == "search"
        local isFiltered = type(target) == "table" and target.action == "filtered"
        local isRScripts = type(target) == "table" and target.action == "rscripts"
        local isRScriptsDetail = type(target) == "table" and target.action == "rscriptsDetail"
        local rsFilters = isRScripts and Filters.normalize(target.filters) or nil
        local isHaxHell = type(target) == "table" and target.action == "haxhell"
        local isHaxHellDetail = type(target) == "table" and target.action == "haxhellDetail"
        local isHaxHellCode = type(target) == "table" and target.action == "haxhellCode"
        local filters = isFiltered and Filters.normalize(target.filters) or nil
        local haxhellFilters = isHaxHell and Filters.normalize(target.filters) or nil
        local isDetail = type(target) == "string"
        if isPeople then
            if type(target.query) ~= "string" or #target.query > 480 or target.query == ""
                or normalizeSearch(target.query) ~= target.query or type(target.cursor) ~= "string" or #target.cursor > 2048 then
                return {error = "Invalid people search"}
            end
        elseif isProfile then
            if not numericId(target.userId) then return {error = "Invalid user ID"} end
        elseif isRobloxGames then
            if type(target.page) ~= "number" or target.page < 1 or target.page > 5
                or target.page ~= math.floor(target.page) or type(target.query) ~= "string"
                or #target.query > 480 or normalizeSearch(target.query) ~= target.query then
                return {error = "Invalid Roblox games request"}
            end
        elseif isRScripts then
            if not rsFilters or type(target.query) ~= "string" or #target.query > 480
                or normalizeSearch(target.query) ~= target.query
                or type(target.page) ~= "number" or target.page < 1 or target.page > 200
                or target.page ~= math.floor(target.page)
                or type(target.gameOnly) ~= "boolean" then
                return {error = "Invalid RScripts request"}
            end
        elseif isRScriptsDetail then
            if not identifier(target.slug) then return {error = "Invalid RScripts slug"} end
        elseif isHaxHell then
            if not haxhellFilters or type(target.query) ~= "string" or #target.query > 480
                or normalizeSearch(target.query) ~= target.query
                or type(target.page) ~= "number" or target.page < 1 or target.page > 1000000
                or target.page ~= math.floor(target.page)
                or type(target.gameOnly) ~= "boolean" then
                return {error = "Invalid HaxHell request"}
            end
        elseif isHaxHellDetail or isHaxHellCode then
            if not identifier(target.slug) then
                return {error = "Invalid HaxHell script identifier"}
            end
        elseif isFiltered then
            if not filters or type(target.query) ~= "string" or #target.query > 480
                or normalizeSearch(target.query) ~= target.query
                or type(target.page) ~= "number" or target.page < 1
                or target.page > 1000000 or target.page ~= math.floor(target.page)
                or type(target.gameOnly) ~= "boolean"
                or (target.gameOnly and not numericId(game.PlaceId)) then
                return {error = "Invalid filtered catalogue request"}
            end
        elseif isSearch then
            if type(target.query) ~= "string" or #target.query > 480
                or normalizeSearch(target.query) == "" or normalizeSearch(target.query) ~= target.query
                or type(target.page) ~= "number" or target.page < 1
                or target.page > 1000000 or target.page ~= math.floor(target.page)
                or type(target.gameOnly) ~= "boolean"
                or (target.gameOnly and not numericId(game.PlaceId)) then
                return {error = "Invalid search request"}
            end
        elseif isGame then
            if type(target.page) ~= "number" or target.page < 1
                or target.page > 1000000 or target.page ~= math.floor(target.page)
                or not numericId(game.PlaceId) then
                return {error = "Invalid game catalogue request"}
            end
        elseif isCode then
            if not identifier(target.id) then
                return {error = "Invalid source identifier"}
            end
        elseif isComments then
            if not identifier(target.id) or type(target.page) ~= "number" or target.page < 1
                or target.page > 10000 or target.page ~= math.floor(target.page) then
                return {error = "Invalid comments request"}
            end
        elseif isDetail then
            if not identifier(target) then
                return {error = "Invalid script identifier"}
            end
        elseif type(target) ~= "number" or target ~= target or target < 1 or target > 1000000 or target ~= math.floor(target) then
            return {error = "Invalid page"}
        end
        local key = (isPeople and ("people:" .. target.query .. ":" .. target.cursor))
            or (isProfile and ("profile:" .. numericId(target.userId)))
            or (isRobloxGames and ("robloxGames:" .. target.page .. ":" .. target.query))
            or (isRScripts and ("rscripts:" .. tostring(target.page) .. ":"
                .. tostring(target.gameOnly) .. ":" .. Filters.key(rsFilters) .. ":" .. target.query))
            or (isRScriptsDetail and ("rscriptsDetail:" .. target.slug))
            or isHaxHell and ("haxhell:" .. (target.gameOnly and tostring(game.PlaceId) or "all")
                .. ":" .. tostring(target.page) .. ":" .. Filters.key(haxhellFilters) .. ":" .. target.query)
            or (isHaxHellDetail and ("haxhellDetail:" .. target.slug))
            or (isHaxHellCode and ("haxhellCode:" .. target.slug))
            or isFiltered and ("filtered:" .. (target.gameOnly and tostring(game.PlaceId) or "all")
                .. ":" .. tostring(target.page) .. ":" .. Filters.key(filters) .. ":" .. target.query)
            or (isSearch and ("search:" .. (target.gameOnly and tostring(game.PlaceId) or "all")
                .. ":" .. tostring(target.page) .. ":" .. target.query))
            or (isCode and ("code:" .. target.id))
            or (isComments and ("comments:" .. target.id .. ":" .. tostring(target.page)))
            or (isGame and ("game:" .. tostring(game.PlaceId) .. ":" .. tostring(target.page))) or target
        local now = os.clock()
        local activity = recent[player] or {}
        recent[player] = activity
        local kind = isPeople and "people" or isProfile and "profile" or isRobloxGames and "robloxGames" or isRScripts and "rscripts" or (isRScriptsDetail and "rscriptsDetail")
            or isHaxHell and "haxhell" or ((isHaxHellDetail or isHaxHellCode) and "haxhellDetail")
            or ((isSearch or isFiltered) and "search" or (isCode and "code" or (isComments and "comments" or (isDetail and "detail" or (isGame and "game" or "page")))))
        if now - (activity[kind] or -math.huge) < (isCode and 0.6 or (isDetail and 0.25 or 0.5)) then
            return {error = "Please try again"}
        end
        activity[kind] = now
        local entry = cache[key]
        if entry and now - entry.time < (isCode and 90 or (isComments and 30 or (isDetail and 5 or 1))) then
            return entry.data
        end
        if pending[key] then
            return {error = "Already loading"}
        end
        if now - windowStart >= 60 then
            windowStart, requests = now, 0
        end
        if requests >= 45 then
            return {error = "Request limit reached"}
        end
        requests += 1
        pending[key] = true
        local ok, data
        if isPeople then
            ok, data = pcall(People.search, target.query, target.cursor)
        elseif isProfile then
            ok, data = pcall(People.profile, target.userId)
        elseif isRobloxGames then
            ok, data = pcall(fetchRobloxGames, target.page, target.query)
        elseif isRScripts then
            ok, data = pcall(fetchRScriptsCatalogue, target.page, target.query, rsFilters, target.gameOnly)
        elseif isRScriptsDetail then
            ok, data = pcall(fetchRScriptsDetails, target.slug)
        elseif isHaxHell then
            ok, data = pcall(fetchHaxHellCatalogue, target.page, target.query, haxhellFilters, target.gameOnly)
        elseif isHaxHellDetail then
            ok, data = pcall(fetchHaxHellDetails, target.slug)
        elseif isHaxHellCode then
            ok, data = pcall(fetchHaxHellCode, target.slug)
        elseif isFiltered then
            ok, data = pcall(fetchCatalogue, target.page, target.gameOnly and game.PlaceId or nil, target.query, filters)
        elseif isSearch then
            ok, data = pcall(fetchCatalogue, target.page, target.gameOnly and game.PlaceId or nil, target.query)
        elseif isGame then
            ok, data = pcall(fetchCatalogue, target.page, game.PlaceId)
        elseif isCode then
            ok, data = pcall(fetchCode, target.id)
        elseif isComments then
            ok, data = pcall(fetchComments, target.id, target.page)
        else
            ok, data = pcall(isDetail and fetchDetails or fetchCatalogue, target)
        end
        pending[key] = nil
        if not ok then
            warn("ScriptFinder: " .. tostring(data))
            return {error = "Server HTTP request failed; see server output"}
        end
        if not cache[key] then
            table.insert(order, key)
        end
        cache[key] = {time = os.clock(), data = data}
        if #order > 64 then
            cache[table.remove(order, 1)] = nil
        end
        return data
    end
    Players.PlayerRemoving:Connect(function(player)
        recent[player] = nil
    end)
    return
end

